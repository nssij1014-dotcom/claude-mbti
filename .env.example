# 로컬 개발용 SQLite 파일 DB. 운영 배포 시 PostgreSQL 연결 문자열로 교체하세요
# (예: postgresql://user:password@host:5432/mbti).
DATABASE_URL="file:./dev.db"

# 카카오톡 공유(Kakao Link)에 필요한 JavaScript 키. Kakao Developers에서 발급받아 채우세요.
# 값이 비어 있으면 카카오톡 공유 버튼은 자동으로 Web Share API/링크복사 폴백으로 동작합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Auth.js(NextAuth) 세션 서명용 비밀키. 터미널에서 `npx auth secret`으로 생성해 채우세요.
AUTH_SECRET=

# Google OAuth 클라이언트 자격 증명 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보
# > OAuth 클라이언트 ID > 웹 애플리케이션). 승인된 리디렉션 URI에
# http://localhost:3000/api/auth/callback/google (로컬)과 배포 도메인의
# /api/auth/callback/google 을 등록하세요. 비어 있으면 로그인 버튼을 눌러도 인증이
# 실패합니다(다른 핵심 플로우에는 영향 없음).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
